@{
    ViewData["Title"] = "Recruiter";
    Layout = "";
}

@*<script src="~/js/rec.js"></script>*@
 
<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="~/DataTableFiles/css/jquery.dataTables.min.css" rel="stylesheet" type="text/css">
<link href="~/DataTableFiles/css/buttons.dataTables.min.css" rel="stylesheet" />
<link href="~/DataTableFiles/css/colReorder.dataTables.min.css" rel="stylesheet" />
<link href="~/DataTableFiles/css/jquery.dataTables.css" rel="stylesheet" />
<script src="~/DataTableFiles/js/jquery.dataTables.js"></script>
@*<script src="~/DataTableFiles/js/jquery-1.12.0.min.js"></script>*@
<script src="~/DataTableFiles/js/jquery.dataTables.min.js"></script>
<script src="~/DataTableFiles/js/dataTables.colReorder.min.js"></script>
<script src="~/DataTableFiles/js/buttons.colVis.min.js"></script>
<script src="~/DataTableFiles/js/buttons.flash.min.js"></script>
<script src="~/DataTableFiles/js/jszip.min.js"></script>
<script src="~/DataTableFiles/js/pdfmake.min.js"></script>
<script src="~/DataTableFiles/js/vfs_fonts.js"></script>
<script src="~/DataTableFiles/js/buttons.html5.min.js"></script>
<script src="~/DataTableFiles/js/buttons.print.min.js"></script>
<script src="~/DataTableFiles/js/dataTables.buttons.min.js"></script> 
<script src="~/crtscripts/recruiting.js"></script>
<link href="~/css/bootstrap.css" rel="stylesheet" />
<link href="~/css/bootstrap.min.css" rel="stylesheet" />
<link href="~/css/popup.css" rel="stylesheet" />
<link href="~/css/commonstyle.css" rel="stylesheet" />
<style>
    audio, canvas, progress, video {
        display: block !important;
        vertical-align: baseline;
        width: 92%;
        position: absolute;
        top: -3px;
        left: 0;
    }

 
    .col-md-8 {
        padding: 10px !important;
    }

    .col-md-6, .col-md-8 {
        padding: 10px !important;
    } 
 </style>
<div class="maindiv">
    <a class="btn_white" onclick="openbtn();">Add</a>
</div>
<table id="tblEnquiry" class="display" style="width:100%;">
    <thead>
        <tr>
            <td>Sn#</td>
            <td>Edit</td>
            <td>Delete</td>
            @*<td>Edid</td>*@
            <td>Name</td>
            <td>Email ID</td>
            <td>Mobile No</td>
            <td>Gender</td> 
            <td>State</td>
            <td>City</td>
            <td>Emp Type</td> 
            <td>Exp (Yrs)</td>
            <td>Apply For</td>
            <td>Qualification</td> 
            <td>CV/Resume</td> 
            <td>Created Date</td> 
        </tr>
    </thead>
    <tbody></tbody>
</table>
<div id="popup1" class="overlay">
    <div class="popup" style="max-width: 95%;">
        <h2>Recruitment Form</h2> 
        <i class="fa fa-times-circle faclose" onclick="closebtn();"></i>
        <div class="content">
            <input type="hidden" value="0" id="empId" /> 
            <div class="popup-form">
                <div>

                    <div class="col-md-4 col-6">

                        <input type="text" name="empName" id="empName" value="" placeholder="Name" class="input-field" />
                    </div>

                    <div class=" col-md-4 col-6">

                        <input type="text" name="empEmail" id="empEmail" value="" placeholder="Email Id" class="input-field" />
                    </div>

                    <div class=" col-md-4 col-6">

                        <input type="text" name="empMobileNo" id="empMobileNo" value="" placeholder="Mobile No" class="input-field" />
                    </div>

                    <div class=" col-md-4 col-6">

                         <select name="courseType" id="empGender" class="input-field">
                            <option value="0">Select Gender</option>
                                 <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                    </div>
                     <div class=" col-md-4 col-6">

                        <select name="empState" id="empState" class="input-field">
                               <option value="0">Select State</option>
                                 <option value="UttarPradesh">UttarPradesh</option>
                            <option value="Maharashtra">Maharashtra</option>
                            </select>
                           
                    </div>
                     <div class=" col-md-4 col-6">

                        <select name="empCity" id="empCity" class="input-field">
                            <option value="0">Select City</option>
                            <option value="Bareilly">Bareilly</option>
                            <option value="Mumbai">Mumbai</option>
                        </select>
                    </div>
                      <div class=" col-md-4 col-6">

                        <select name="empEmpTypes" id="empEmpTypes" class="input-field">
                                  <option value="0">Select Emp Type</option>
                                 <option value="Fresher">Fresher</option>
                            <option value="Experince">Experince</option>
                            </select>
                      </div>

                         <div class=" col-md-4 col-6">

                        <input type="text" name="empExpYears" id="empExpYears" value="" placeholder="Experience" class="input-field" />
                        </div>
                         <div class=" col-md-4 col-6">

                        <input type="text" name="empQualification" id="empQualification" value="" placeholder="Qualification" class="input-field" />
                      </div>
                         <div class=" col-md-4 col-6">
                        <select name="empApplyFor" id="empApplyFor" class="input-field">
                                  <option value="0">Select Job Profile</option>
                                 <option value="Angular Front-End">Angular Front-End</option>
                                <option value="ReactJs Engineer">ReactJs Engineer</option>
                                 <option value="JavaScript Developer">JavaScript Developer</option>
                            <option value="Java FullStack Developer">Java FullStack Developer</option>
                                    <option value="Dot.Net FullStack Developer">Dot.Net FullStack Developer</option>
                            <option value="PhP Laravel Developer">PhP Laravel Developer</option>
                            <option value="Android Application Developer">Android Application Developer</option>
                              <option value="Ionic Framework Developer">Ionic Framework Developer</option>
                            <option value="NodeJs Developer">NodeJs Developer</option>
                            </select>
                    </div>
                         
                     
                        <div class="col-md-6 col-6">
                        <input type="file" accept="application/msword, application/pdf, image/*" id="empResume" name="empResume" class="input-field" />

                    </div>
                        <div class="col-md-2 col-6">
                            <progress id="ctlProgress" value="0" max="100"></progress>
                            <input type="button" name="submit" value="Uplaod" class="btn btn-danger btnupload" onclick="uplaodresume();" />
                        </div>
                     <div class=" col-md-4 col-6">
                      </div>
 
                    <div class=" col-md-4 col-6">
                        <input type="button" name="submit" value="Submit" class="btn btn-success" style="width: 47% !important;" onclick="empsave();"/>
                        <input type="button" name="submit" value="Cancel" class="btn delbtn" style="width: 47% !important;" />

                    </div>
                       <div class=" col-md-4 col-6">
                      </div>
                </div>

            </div>



        </div>
    </div>


</div>
 
 