<div class="maindiv">
    <a class="btn_white" onclick="openbtn();">Add</a>
</div>
<table id="tblEnquiry" class="display" style="width:100%;">
    <thead>
        <tr>
            <td>Sn#</td>
            <td>Edit</td>
            <td>Delete</td>
            <td>AccountStatus</td>
            <td>AccessCredential</td>
            @*<td>Edid</td>*@
            <td>UserName</td>
            <td>Password</td>
            <td>CreatedBy</td>
            <td>CreatedDate</td>
        </tr>
    </thead>
    <tbody></tbody>
</table>
<div id="popup1" class="overlay">
    <div class="popup" style="max-width: 95%;">
        <h2>Recruitment Form</h2>
        <i class="fa fa-times-circle faclose" onclick="closebtn();"></i>
        <div class="content">
            <input type="hidden" value="0" id="UserRId" />
            <div class="popup-form">
                <div>

                    <div class="col-md-4 col-6">

                        <input type="text" name="UserName" id="UserName" value="" placeholder="Enter New UserID" class="input-field" />
                    </div>

                    <div class=" col-md-4 col-6">

                        <input type="text" name="Password" id="Password" value="" placeholder="Enter New Password" class="input-field" />
                    </div>

                    <div class=" col-md-4 col-6">

                        
                                <div class="checkboxes input-field">
                                    <input id="isactive" class="ckb ckb-primary" type="checkbox"  />
                                    <label for="ckb0">Active/DeActive Admin</label>
                                     
                                </div>
                           
                    </div>

                    <div class=" col-md-4 col-6">

                        <select name="rollid" id="rollid" class="input-field">
                            
                        </select>
                    </div>
                    
    
                    <div class=" col-md-4 col-6">
                    </div>

                    <div class=" col-md-4 col-6">
                        <input type="button" name="submit" value="Submit" class="btn btn-success" style="width: 47% !important;" onclick="NewAdmin();" />
                        <input type="button" name="submit" value="Cancel" class="btn delbtn" style="width: 47% !important;" />

                    </div>
                    <div class=" col-md-4 col-6">
                    </div>
                </div>

            </div>



        </div>
    </div>


</div>

