                <i class="fas fa-lock"></i>
                <input type="password" name="contraseña" autocomplete="current-password" placeholder="Password" id="id_reg" required="yes">
                <i class="far fa-eye" id="toggleReg" style="cursor: pointer;"></i>
            </div>

            <input type="submit" value="Create account" class="btn solid">

        </form>*@
                </div>
            </div>
            <div class="panels-container">
                <div class="panel left-panel">
                    <div class="content">
                        <div>
                            <svg width="48" height="48" class="loginlogo" style="color: white !important" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"> <path d="M30.865 3.448l-6.583-3.167c-0.766-0.37-1.677-0.214-2.276 0.385l-12.609 11.505-5.495-4.167c-0.51-0.391-1.229-0.359-1.703 0.073l-1.76 1.604c-0.583 0.526-0.583 1.443-0.005 1.969l4.766 4.349-4.766 4.349c-0.578 0.526-0.578 1.443 0.005 1.969l1.76 1.604c0.479 0.432 1.193 0.464 1.703 0.073l5.495-4.172 12.615 11.51c0.594 0.599 1.505 0.755 2.271 0.385l6.589-3.172c0.693-0.333 1.13-1.031 1.13-1.802v-21.495c0-0.766-0.443-1.469-1.135-1.802zM24.005 23.266l-9.573-7.266 9.573-7.266z" fill="blue"></path> </svg>
                            @*<img src="~/assets/images/sitelogo.png" class="loginlogo" />*@

                        </div>
                        <h3>Chayanika Recruit Tech</h3>
                        <p>A Great Place to Think Big Thoughts</p>
                        @*<button class="btn transparent" id="sign-up-btn">Bareilly</button>*@
                    </div>
                    <img src="img/log.svg" class="image" alt="">
                </div>

                <div class="panel right-panel">
                    <div class="content">
                        <h3>Already have an account?</h3>
                        <p>Login to see your notifications and post your favorite photos</p>
                        <button class="btn transparent" id="sign-in-btn">Sign in</button>
                    </div>
                    <img src="img/register.svg" class="image" alt="">
                </div>
            </div>
        </div>
    </div>
    <!-- jQuery if needed -->

    <script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.8.2/jquery.min.js"></script>

</body>
</html>
