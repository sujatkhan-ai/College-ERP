@model CRT_Entity.AdminAccess
@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @*<script src="https://code.jquery.com/jquery-1.12.4.min.js" integrity="sha384-nvAa0+6Qg9clwYCGGPpDQLVpLNn0fRaROjHqs13t4Ggj3Ez50XnGQqc/r8MhnRDZ" crossorigin="anonymous"></script>*@
    @*<script src="~/CRTScripts/NiceHMS.js"></script>*@
    <title>WELCOME IN CHAYANIKA</title>

    <script src="~/js/loginsk.js"></script>
    <link href="~/css/loginsk.css" rel="stylesheet" />
    @*<script type="text/javascript">
            window.onload = function () {
                if (window != window.top) {
                    window.top.location = "/UserManagment/Login";
                    window.close();
                }
            };
        </script>*@
    <style>
        a:link, a:visited, a:active, a:hover {
            color: #ffffff;
            background: none;
        }

        .error {
            word-wrap: break-word;
            color: #ff0909 !important;
            text-shadow: none !important;
            font-weight: 700 !important;
            margin-left: 12%;
        }
    </style>
</head>
<body>
 
    <div class="container">
        <div class="container">
            <div class="forms-container">
                <div class="signin-signup">
                    @using (Html.BeginForm("SRSoftwareUserLogin", "User", FormMethod.Post, new { @class = "sign -in-form" }))
                    {

                        <h2 class="title">Login Here!..</h2>
                        <div class="input-field">
                            <i class="fas fa-user"></i>
                            @*<input type="text" name="usuario" autocomplete="username" placeholder="Username" required="yes">*@
                            @Html.TextBoxFor(m => m.UserName, new { @autocomplete = "username", @placeholder = "User Name or email", @required = "yes" })
                        </div>
                        <div class="input-field">
                            <i class="fas fa-lock"></i>
                            @*<input type="password" name="contraseña" autocomplete="current-password" placeholder="Password" id="id_password" required="yes">*@
                            @Html.TextBoxFor(m => m.Password, new { @autocomplete = "current-password", @type = "Password", @placeholder = "Password", @required = "yes" })
                            <i class="far fa-eye" id="togglePassword" style="cursor: pointer;"></i>
                        </div>

                        @*<a class="pass" href="#">Forgot your password?</a>*@
                        <input type="submit" value="Sign in" class="btn solid">

                    }

                     
                    @*<form action="" class="sign-up-form">
            <h2 class="title">Register Now!..</h2>
            <div class="input-field">
                <i class="fas fa-user"></i>
                <input type="text" name="usuario" autocomplete="username" placeholder="Username" required="yes">
            </div>
            <div class="input-field">
                <i class="fas fa-envelope"></i>
                <input type="email" name="correo" autocomplete="email" placeholder="Email" required="yes">
            </div>
